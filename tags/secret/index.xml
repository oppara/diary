<?xml version="1.0" encoding="utf-8" standalone="yes"?><rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:content="http://purl.org/rss/1.0/modules/content/"><channel><title>Secret on d.oppara.tv</title><link>https://d.oppara.tv/tags/secret/</link><description>Recent content in Secret on d.oppara.tv</description><generator>Hugo -- 0.148.2</generator><language>ja</language><lastBuildDate>Sat, 30 May 2026 08:47:25 +0900</lastBuildDate><atom:link href="https://d.oppara.tv/tags/secret/index.xml" rel="self" type="application/rss+xml"/><item><title>シークレットを即時削除する</title><link>https://d.oppara.tv/posts/2026/05/aws-secretsmanager-delete-secret/</link><pubDate>Sat, 30 May 2026 08:47:25 +0900</pubDate><guid>https://d.oppara.tv/posts/2026/05/aws-secretsmanager-delete-secret/</guid><description>&lt;h2 id="はじめに">はじめに&lt;/h2>
&lt;p>AWS Secrets Manager のシークレットを即時削除したい。&lt;/p>
&lt;h2 id="手順">手順&lt;/h2>
&lt;div class="highlight">&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-shell" data-lang="shell">&lt;span style="display:flex;">&lt;span>aws secretsmanager delete-secret &lt;span style="color:#ae81ff">\
&lt;/span>&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#ae81ff">&lt;/span> --secret-id &lt;span style="color:#e6db74">&amp;#34;your-secret-name&amp;#34;&lt;/span> &lt;span style="color:#ae81ff">\
&lt;/span>&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#ae81ff">&lt;/span> --force-delete-without-recovery
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div>&lt;h2 id="環境">環境&lt;/h2>
&lt;div class="highlight">&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-console" data-lang="console">&lt;span style="display:flex;">&lt;span>$ aws --version
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>aws-cli/2.34.54 Python/3.14.5 Linux/6.1.166-197.305.amzn2023.x86_64 exec-env/CloudShell exe/x86_64.amzn.2023
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/div></description></item></channel></rss>